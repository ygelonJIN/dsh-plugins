{
  "name": "@local/self-check",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-check page plus a startup roster check: one settings tab lists every @local plugin's last upgrade self-check, and a corner notice appears after a DSH upgrade or when a plugin did not load.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "scripts": {
    "test": "node test/watch.test.mjs"
  }
}
