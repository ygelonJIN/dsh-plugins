{
  "name": "dsh-profile-desktop",
  "private": true,
  "dsh": {
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-web-app",
        "@deepseek-ai/dsh-experimental-inspector-profile",
        "@local/usage-cost",
        "@local/harness-period",
        "@local/skin",
        "@local/session-delete",
        "@local/session-undo",
        "@local/sidebar-marks",
