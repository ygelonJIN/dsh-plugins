    "@local/self-check": "link:{{REPO}}/self-check",
    "@local/session-delete": "link:{{REPO}}/session-delete",
    "@local/session-undo": "link:{{REPO}}/session-undo",
    "@local/sidebar-marks": "link:{{REPO}}/sidebar-marks",
    "@local/skin": "link:{{REPO}}/skin",
    "@local/usage-cost": "link:{{REPO}}/usage-cost",
    "@local/workspace-ledger": "link:{{REPO}}/workspace-ledger",
    "@local/prompt-inject": "link:{{REPO}}/prompt-inject"
  }
