{
  "name": "@local/sidebar-marks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sidebar marks: toggle a black underline on conversations and workspaces from the \"…\" menus, and give the open conversation and running rows a stronger look.",
  "scripts": {
    "test": "node test/marks.test.mjs && node test/route.test.mjs && node test/client.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "marks.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
